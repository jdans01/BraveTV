<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- ╔══════════════════════════════════════════════════════╗ -->
    <!-- ║  BARRA DE NAVEGACIÓN (visible en modo navegador)    ║ -->
    <!-- ╚══════════════════════════════════════════════════════╝ -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="&#9654; YT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/btn_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/btnSearch" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#128269;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnYoutube"
            android:nextFocusRight="@id/urlBar" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/url_bar_bg"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="Escribe una URL..."
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearch"
            android:nextFocusRight="@id/btnVpn" />

        <Button
            android:id="@+id/btnVpn"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="&#127758; Auto"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/btn_vpn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true"
            android:nextFocusLeft="@id/urlBar"
            android:nextFocusRight="@id/btnBack" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#9664;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnVpn"
            android:nextFocusRight="@id/btnForward" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#9654;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnBack"
            android:nextFocusRight="@id/btnRefresh" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#8635;"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnForward"
            android:nextFocusDown="@id/webView" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#8962;"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnRefresh" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/navBar"
        android:progressTint="#FF6B35"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/navBar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text=""
        android:textColor="#44FFFFFF"
        android:textSize="10sp"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- ╔══════════════════════════════════════════════════════╗ -->
    <!-- ║  PANTALLA DE INICIO                                  ║ -->
    <!-- ╚══════════════════════════════════════════════════════╝ -->
    <RelativeLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D">

        <!-- Logo + título -->
        <LinearLayout
            android:id="@+id/homeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#129503;"
                android:textSize="52sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BraveTV Browser"
                android:textColor="#FF6B35"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elige tu modo de navegación"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Tarjetas de acceso rápido -->
        <LinearLayout
            android:id="@+id/homeCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/homeHeader"
            android:layout_marginTop="28dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <!-- Tarjeta 1: Brave Browser -->
            <LinearLayout
                android:id="@+id/cardBrave"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_brave"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/cardTor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#129503;"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brave Browser"
                    android:textColor="#FF6B35"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin anuncios · VPN Auto"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Tarjeta 2: Tor Brave -->
            <LinearLayout
                android:id="@+id/cardTor"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_tor"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/cardBrave"
                android:nextFocusRight="@id/cardYtTv">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#129492;"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brave + Privado"
                    android:textColor="#9B59B6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo privado · Sin cookies"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Tarjeta 3: YouTube TV -->
            <LinearLayout
                android:id="@+id/cardYtTv"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_yt"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/cardTor"
                android:nextFocusRight="@id/cardYtWeb">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#128250;"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube TV"
                    android:textColor="#FF4444"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interfaz de televisión"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Tarjeta 4: YouTube Web -->
            <LinearLayout
                android:id="@+id/cardYtWeb"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:background="@drawable/card_yt"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/cardYtTv">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127910;"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube Web"
                    android:textColor="#FF4444"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versión escritorio completa"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- Indicador de estado VPN en la home -->
        <LinearLayout
            android:id="@+id/homeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/homeCards"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/homeVpnStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#127758; VPN AUTO · 🇺🇸 EE.UU."
                android:textColor="#2ECC71"
                android:textSize="13sp"
                android:background="#1A2E1A"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

        <!-- Hint de ayuda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"
            android:text="Botón ATRÁS = volver aquí  ·  Mantén VPN = cambiar región"
            android:textColor="#444444"
            android:textSize="11sp" />

    </RelativeLayout>

</RelativeLayout>
