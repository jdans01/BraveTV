<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C14">

    <!-- NAV BAR -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#0F0F1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="&#9654; Inicio"
            android:textColor="#F1F0FF"
            android:textSize="13sp"
            android:background="@drawable/btn_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/btnSearch" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="&#128269;"
            android:textColor="#F1F0FF"
            android:textSize="16sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="6dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnYoutube"
            android:nextFocusRight="@id/urlBar" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/url_bar_bg"
            android:textColor="#F1F0FF"
            android:textColorHint="#4A4A6A"
            android:hint="Escribe una URL..."
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearch"
            android:nextFocusRight="@id/btnBlockCount" />

        <!-- Contador de bloqueos -->
        <TextView
            android:id="@+id/btnBlockCount"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="&#128683; 0"
            android:textColor="#4ADE80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_vpn"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="false" />

        <Button
            android:id="@+id/btnVpn"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="&#127758; US"
            android:textColor="#F1F0FF"
            android:textSize="11sp"
            android:background="@drawable/btn_vpn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="6dp"
            android:focusable="true"
            android:nextFocusLeft="@id/urlBar"
            android:nextFocusRight="@id/btnBack" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="&#9664;"
            android:textColor="#F1F0FF"
            android:textSize="16sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnVpn"
            android:nextFocusRight="@id/btnForward" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="&#9654;"
            android:textColor="#F1F0FF"
            android:textSize="16sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnBack"
            android:nextFocusRight="@id/btnRefresh" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="&#8635;"
            android:textColor="#F1F0FF"
            android:textSize="20sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnForward"
            android:nextFocusRight="@id/btnHome" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="&#8962;"
            android:textColor="#F1F0FF"
            android:textSize="20sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnRefresh"
            android:nextFocusDown="@id/webView" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/navBar"
        android:progressTint="#C084FC"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/navBar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text=""
        android:textColor="#33FFFFFF"
        android:textSize="10sp"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════ -->
    <!--              PANTALLA DE INICIO             -->
    <!-- ═══════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0C0C14"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="6dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BraveTV"
                    android:textColor="#C084FC"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browser"
                    android:textColor="#F1F0FF"
                    android:textSize="17sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="-4dp" />

            </LinearLayout>

            <!-- Píldora VPN + contador bloqueos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/homeVpnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127758; VPN AUTO · EE.UU."
                    android:textColor="#4ADE80"
                    android:textSize="12sp"
                    android:background="#0D2218"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/homeBlockCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#128683; 0 bloqueados"
                    android:textColor="#FB923C"
                    android:textSize="12sp"
                    android:background="#1E100A"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <!-- Tarjetas de modo — paleta unificada -->
            <LinearLayout
                android:id="@+id/homeCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4">

                <!-- Brave Browser → search.brave.com -->
                <LinearLayout
                    android:id="@+id/cardBrave"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@id/cardTor">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/icon_brave_circle"
                        android:text="B"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brave"
                        android:textColor="#F1F0FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin anuncios · VPN auto"
                        android:textColor="#6B6B8A"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Brave Privado → duckduckgo.com -->
                <LinearLayout
                    android:id="@+id/cardTor"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardBrave"
                    android:nextFocusRight="@id/cardYtTv">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/icon_private_circle"
                        android:text="&#128274;"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privado"
                        android:textColor="#F1F0FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DuckDuckGo · Incógnito"
                        android:textColor="#6B6B8A"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- YouTube TV → youtube.com/tv -->
                <LinearLayout
                    android:id="@+id/cardYtTv"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardTor"
                    android:nextFocusRight="@id/cardYtWeb">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/icon_yttv_circle"
                        android:text="&#9654;"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube TV"
                        android:textColor="#F1F0FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interfaz televisión"
                        android:textColor="#6B6B8A"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- YouTube Web → youtube.com -->
                <LinearLayout
                    android:id="@+id/cardYtWeb"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardYtTv">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/icon_ytweb_circle"
                        android:text="YT"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube Web"
                        android:textColor="#F1F0FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versión escritorio"
                        android:textColor="#6B6B8A"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- Recientes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="RECIENTES"
                android:textColor="#4A4A6A"
                android:textSize="11sp"
                android:letterSpacing="0.12" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recentsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Ayuda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="ATRÁS = salir  ·  Mantén VPN = elegir región"
                android:textColor="#2E2E44"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
