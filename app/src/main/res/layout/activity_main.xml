<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C14">

    <!-- NAV BAR -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0D0D1C"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- Búsqueda / lupa -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="&#128269;"
            android:textColor="#F1F0FF"
            android:textSize="15sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:focusable="true"
            android:nextFocusRight="@id/urlBar" />

        <!-- Barra URL — ocupa todo el espacio disponible -->
        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/url_bar_bg"
            android:textColor="#F1F0FF"
            android:textColorHint="#4A4A6A"
            android:hint="Buscar o escribir URL..."
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="text"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearch"
            android:nextFocusRight="@id/btnBlockCount" />

        <!-- Contador bloqueos -->
        <TextView
            android:id="@+id/btnBlockCount"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="&#128683; 0"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_vpn"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginEnd="3dp"
            android:focusable="false" />

        <!-- VPN -->
        <Button
            android:id="@+id/btnVpn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="&#127758; US"
            android:textColor="#F1F0FF"
            android:textSize="10sp"
            android:background="@drawable/btn_vpn"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:focusable="true"
            android:nextFocusLeft="@id/urlBar"
            android:nextFocusRight="@id/btnBack" />

        <!-- Atrás -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9664;"
            android:textColor="#F1F0FF"
            android:textSize="13sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:layout_marginStart="3dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnVpn"
            android:nextFocusRight="@id/btnForward" />

        <!-- Adelante -->
        <Button
            android:id="@+id/btnForward"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9654;"
            android:textColor="#F1F0FF"
            android:textSize="13sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:layout_marginStart="2dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnBack"
            android:nextFocusRight="@id/btnRefresh" />

        <!-- Recargar -->
        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#8635;"
            android:textColor="#F1F0FF"
            android:textSize="15sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:layout_marginStart="2dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnForward"
            android:nextFocusRight="@id/btnHome" />

        <!-- Inicio -->
        <Button
            android:id="@+id/btnHome"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#8962;"
            android:textColor="#F1F0FF"
            android:textSize="15sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:layout_marginStart="2dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnRefresh"
            android:nextFocusRight="@id/btnCursor" />

        <!-- Puntero (flecha) -->
        <ImageButton
            android:id="@+id/btnCursor"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/cursor_arrow"
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:alpha="0.45"
            android:background="@drawable/btn_cursor"
            android:padding="0dp"
            android:layout_marginStart="2dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnHome"
            android:nextFocusRight="@id/btnHideNav"
            android:contentDescription="Modo puntero" />

        <!-- Ocultar barra -->
        <Button
            android:id="@+id/btnHideNav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9650;"
            android:textColor="#5A5A7A"
            android:textSize="10sp"
            android:background="@drawable/btn_nav"
            android:padding="0dp"
            android:layout_marginStart="2dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnCursor"
            android:nextFocusDown="@id/webView" />

        <!-- btnYoutube oculto para compatibilidad con código Java existente -->
        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:focusable="false" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/navBar"
        android:progressTint="#C084FC"
        android:visibility="gone" />

    <!-- WebView ocupa TODA la pantalla para que el video llene el espacio -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone" />

    <!-- Virtual arrow cursor for pointer mode -->
    <ImageView
        android:id="@+id/cursorDot"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:src="@drawable/cursor_arrow"
        android:elevation="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text=""
        android:textColor="#33FFFFFF"
        android:textSize="10sp"
        android:padding="4dp"
        android:visibility="gone" />

    <!-- Botón flotante para recuperar la barra cuando está oculta -->
    <TextView
        android:id="@+id/btnRevealNav"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        android:text="▼ Menú"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:background="@drawable/pill_reveal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone"
        android:elevation="12dp" />

    <LinearLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                PANTALLA DE INICIO                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0C0C14"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/tv_margin_v"
            android:paddingBottom="36dp"
            android:paddingStart="@dimen/tv_margin_h"
            android:paddingEnd="@dimen/tv_margin_h">

            <!-- ── Cabecera ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BraveTV"
                    android:textColor="#C084FC"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browser"
                    android:textColor="#9090B0"
                    android:textSize="15sp"
                    android:letterSpacing="0.18"
                    android:layout_marginTop="-2dp" />

            </LinearLayout>

            <!-- ── Chips de estado ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/homeVpnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127758; VPN AUTO · EE.UU."
                    android:textColor="#4ADE80"
                    android:textSize="12sp"
                    android:background="@drawable/chip_green"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />

                <TextView
                    android:id="@+id/homeBlockCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#128683; 0 bloqueados"
                    android:textColor="#FB923C"
                    android:textSize="12sp"
                    android:background="@drawable/chip_red"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <!-- ── Cards de modo ── -->
            <LinearLayout
                android:id="@+id/homeCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4">

                <!-- Brave Browser -->
                <LinearLayout
                    android:id="@+id/cardBrave"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/card_gap"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@id/cardTor">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_brave_circle"
                        android:text="B"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brave"
                        android:textColor="#F1F0FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin anuncios · VPN auto"
                        android:textColor="#6B6B8A"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Brave Privado -->
                <LinearLayout
                    android:id="@+id/cardTor"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/card_gap"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardBrave"
                    android:nextFocusRight="@id/cardYtTv">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_private_circle"
                        android:text="&#128274;"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privado"
                        android:textColor="#F1F0FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DuckDuckGo · Incógnito"
                        android:textColor="#6B6B8A"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- YouTube TV -->
                <LinearLayout
                    android:id="@+id/cardYtTv"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/card_gap"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardTor"
                    android:nextFocusRight="@id/cardYtWeb">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_yttv_circle"
                        android:text="&#9654;"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube TV"
                        android:textColor="#F1F0FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interfaz televisión"
                        android:textColor="#6B6B8A"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- YouTube Web -->
                <LinearLayout
                    android:id="@+id/cardYtWeb"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height"
                    android:layout_weight="1"
                    android:background="@drawable/card_mode"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/cardYtTv">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_ytweb_circle"
                        android:text="YT"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube Web"
                        android:textColor="#F1F0FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versión escritorio"
                        android:textColor="#6B6B8A"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Recientes ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="RECIENTES"
                android:textColor="#4A4A6A"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-48dp"
                android:layout_marginEnd="-48dp"
                android:paddingStart="@dimen/tv_margin_h"
                android:paddingEnd="@dimen/tv_margin_h"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/recentsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Ayuda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="ATRÁS = salir  ·  Mantén VPN = elegir región"
                android:textColor="#28283C"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
