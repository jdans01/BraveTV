<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="8dp">

        <!-- YouTube home -->
        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="&#9654; YT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/btn_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:nextFocusRight="@id/btnSearch" />

        <!-- Búsqueda rápida de YouTube -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#128269;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnYoutube"
            android:nextFocusRight="@id/urlBar" />

        <!-- Barra de URL -->
        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/url_bar_bg"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="Escribe una URL..."
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearch"
            android:nextFocusRight="@id/btnVpn" />

        <!-- VPN AUTO (toca = on/off, mantén = elegir región) -->
        <Button
            android:id="@+id/btnVpn"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="&#127758; Auto"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/btn_vpn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true"
            android:nextFocusLeft="@id/urlBar"
            android:nextFocusRight="@id/btnBack" />

        <!-- Atrás -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#9664;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnVpn"
            android:nextFocusRight="@id/btnForward" />

        <!-- Adelante -->
        <Button
            android:id="@+id/btnForward"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#9654;"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnBack"
            android:nextFocusRight="@id/btnRefresh" />

        <!-- Recargar -->
        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="&#8635;"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="5dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnForward"
            android:nextFocusDown="@id/webView" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/navBar"
        android:progressTint="#FF6B35"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/navBar"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text=""
        android:textColor="#44FFFFFF"
        android:textSize="10sp"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone" />

</RelativeLayout>
